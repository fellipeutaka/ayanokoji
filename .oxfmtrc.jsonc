{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.md",
    "**/*.mdx",
    "**/*.yaml",
    "**/*.yml",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/.source/**",
    "**/out/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/.cache/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/.svelte-kit/**",
    "**/.vitepress/cache/**",
    "**/.vitepress/dist/**",
    "**/.vercel/**",
    "**/.netlify/**",
    "**/storybook-static/**",
    "**/.docusaurus/**",
    "**/public/build/**",
    "**/.parcel-cache/**",
    "**/.vite/**",
    "**/.astro/**",
    "**/_astro/**",
    "**/_generated/**",
    "**/*.gen.*",
    "**/*.generated.*",
    "**/*.auto.*",
    "**/generated/**",
    "**/auto-generated/**",
    "**/codegen/**",
    "**/__generated__/**",
    "**/*.min.*",
    "**/*.d.ts.map",
    "**/next-env.d.ts",
    "**/.env",
    "**/.env.*",
  ],
}
