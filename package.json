{
  "name": "root",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "clean": "rimraf --glob \"{apps,packages}/*/{node_modules,dist}\" \"node_modules\" \".turbo\"",
    "lint": "pnpm --filter docs exec next typegen && oxlint .",
    "lint:fix": "pnpm --filter docs exec next typegen && oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "cli": "pnpm --filter ayanokoji",
    "docs": "pnpm --filter docs",
    "release": "pnpm run build && pnpm exec changeset publish",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "lefthook": "^2.0.16",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "^6.1.2",
    "turbo": "^2.7.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
