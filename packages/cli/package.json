{
  "name": "ayanokoji",
  "description": "A CLI to setup some tools for a new project",
  "type": "module",
  "private": false,
  "version": "0.11.0",
  "author": {
    "name": "Fellipe Utaka",
    "email": "fellipeutaka@gmail.com",
    "url": "https://github.com/fellipeutaka"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fellipeutaka/ayanokoji.git",
    "directory": "packages/cli"
  },
  "main": "./dist/index.mjs",
  "exports": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "bin": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "start": "node .",
    "test": "vitest run",
    "type-check": "tsc --noEmit --incremental false",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:doctor": "ultracite doctor"
  },
  "devDependencies": {
    "tsdown": "^0.20.1",
    "type-fest": "^5.4.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@antfu/ni": "^28.2.0",
    "@clack/prompts": "^1.0.0",
    "commander": "^14.0.3",
    "nano-spawn": "^2.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  }
}
